{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Keel",
  "version": "1.3.0",
  "identifier": "cloud.framestudio.keel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Keel — Business Dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNzFEN0VDQTEwMEUzMgpSV1F5RGhES2ZoMFhBNmg0WFpHSFNIdVZGdEVhSlE0RDNsU1dCeVNOM25ZRUhiUXQ0cVpjdHNFaQo=",
      "endpoints": ["https://github.com/FrameStudio-cloud/keel-desktop/releases/latest/download/updater.json"]
    }
  }
}
